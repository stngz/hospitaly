// Version: 3.0.0-p0-data-session
// Date: 2026-10-30
// Single Source of Truth: Never paste rules into the console by hand. Always deploy via repository script.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: properties
    // Document ID: propertyId (e.g., 'prop_rocks_lusaka')
    // Fields:
    //   - name: string (required)
    //   - slug: string (required)
    //   - status: string ('active' | 'suspended')
    //   - contactPhone: string
    //   - whatsappPhone: string
    //   - timezone: string
    //   - currency: string
    //
    // Subcollection: properties/{propertyId}/private
    // Document ID: settingDoc (e.g., 'settings')
    // Fields:
    //   - contactEmail: string
    //   - suspendedBy: string | null
    //   - suspendedAt: string | null
    //
    // Collection: rooms
    // Document ID: roomId (e.g., 'room_rocks_101')
    // Fields:
    //   - propertyId: string (required, immutable)
    //   - name: string (required)
    //   - houseType: string (required)
    //   - status: string ('available' | 'occupied' | 'maintenance')
    //   - activeStayId: string | null
    //   - archived: bool
    //   - wifiName: string
    //   - wifiPassword: string
    //
    // Collection: stays
    // Document ID: stayId (e.g., 'stay_...')
    // Fields:
    //   - propertyId: string (required, immutable)
    //   - roomId: string (required)
    //   - status: string ('active' | 'completed' | 'cancelled')
    //   - guestName: string
    //   - guestPhone: string
    //   - checkInAt: string
    //   - checkOutAt: string
    //
    // Collection: qrCodes
    // Document ID: token (e.g., random base62 string)
    // Fields:
    //   - token: string (required, immutable)
    //   - propertyId: string (required)
    //   - roomId: string (required)
    //   - activeStayId: string | null
    //   - status: string ('active' | 'revoked')
    //   - houseName: string
    //   - houseType: string
    //   - imageId: string
    //   - wifiName: string
    //   - wifiPassword: string
    //   - guestGreeting: string
    //
    // Collection: guestSessions
    // Document ID: uid (matches request.auth.uid of anonymous guest)
    // Fields:
    //   - token: string (required)
    //   - roomId: string (required)
    //   - stayId: string (required)
    //   - propertyId: string (optional)
    //   - createdAt: string | timestamp
    //
    // Collection: requests
    // Document ID: requestId (e.g., 'req_...')
    // Fields:
    //   - propertyId: string (required, immutable)
    //   - roomId: string (optional for legacy, immutable if present)
    //   - stayId: string (required)
    //   - guestUid: string (optional, matches request.auth.uid for guest)
    //   - title: string (required)
    //   - description: string
    //   - status: string ('pending' | 'in_progress' | 'completed' | 'cancelled')
    //   - verification: string ('pending' | 'verified' | 'reopened' | 'none')
    //   - verifiedBy: string
    //   - verifiedAt: string | timestamp
    //   - archived: bool
    //   - deliveryPreference: string ('knock' | 'leave_at_door')
    //   - assignedTo: string | null
    //
    // Collection: users
    // Document ID: userId (matches request.auth.uid)
    // Fields:
    //   - email: string (required)
    //   - role: string ('founder' | 'manager' | 'staff' | 'admin')
    //   - propertyId: string
    //   - active: bool
    //
    // Collection: activity
    // Document ID: activityId
    // Fields:
    //   - propertyId: string
    //   - userId: string
    //   - action: string
    //   - summary: string
    //   - createdAt: string | timestamp
    //
    // ===============================================================
    // Helper Functions & Security Invariants
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Pilot test accounts on local emulator or unverified test environments
    function isEmailVerifiedOrPilot() {
      return isAuthenticated() && (
        request.auth.token.email_verified == true || (
          request.auth.token.firebase.sign_in_provider == 'password' && (
            request.auth.token.email in [
              'founder.pilot@hospitaly.app',
              'manager.pilot@example.com',
              'staff.pilot@example.com',
              'housekeeping.pilot@example.com',
              'maintenance.pilot@example.com',
              'nathanielmazaba@gmail.com'
            ] ||
            hasUserProfile()
          )
        )
      );
    }

    function hasUserProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      return isAuthenticated() &&
        isEmailVerifiedOrPilot() &&
        hasUserProfile() &&
        getUserData().active == true;
    }

    // Platform Founder strictly defined by active profile with founder/admin role
    function isPlatformFounder() {
      return isUserActive() && getUserData().role in ['founder', 'admin'];
    }

    function isPropertyManager(propId) {
      return isPlatformFounder() || (
        isUserActive() &&
        getUserData().role in ['manager', 'admin'] &&
        getUserData().propertyId == propId
      );
    }

    function isStaffMember(propId) {
      return isPlatformFounder() || (
        isUserActive() &&
        getUserData().role in ['staff', 'manager', 'admin'] &&
        getUserData().propertyId == propId
      );
    }

    function isPropertyActive(propId) {
      return exists(/databases/$(database)/documents/properties/$(propId)) &&
        get(/databases/$(database)/documents/properties/$(propId)).data.status == 'active';
    }

    function hasActiveGuestSession(uid, roomId, stayId) {
      return exists(/databases/$(database)/documents/guestSessions/$(uid)) &&
        get(/databases/$(database)/documents/guestSessions/$(uid)).data.roomId == roomId &&
        get(/databases/$(database)/documents/guestSessions/$(uid)).data.stayId == stayId;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Properties:
    // - Active properties readable by anyone; suspended readable by platform founder or assigned staff
    // - Updates allowed by Founder, or by Manager of that property (cannot change property status)
    // - Subcollection 'private': contactEmail, suspendedBy accessible only to founder or staff of property
    match /properties/{propertyId} {
      allow get: if resource.data.status == 'active' || isPlatformFounder() || isStaffMember(propertyId);
      allow list: if isPlatformFounder() || (isUserActive() && getUserData().role in ['staff', 'manager', 'admin']);

      allow create: if isPlatformFounder();

      allow update: if isPlatformFounder() || (
        isPropertyManager(propertyId) &&
        isPropertyActive(propertyId) &&
        request.resource.data.status == resource.data.status
      );

      allow delete: if isPlatformFounder();

      match /private/{settingDoc} {
        allow read, write: if isPlatformFounder() || isStaffMember(propertyId);
      }
    }

    // Rooms (Houses):
    // - No public read. Only platform founder or staff member of that property can get or list.
    // - Create: Founder only (Wave 2 Q2 requirement).
    // - Update: Founder, or property manager (if active), or staff member for operational fields.
    // - Delete: Founder only.
    match /rooms/{roomId} {
      allow get: if isPlatformFounder() || isStaffMember(resource.data.propertyId);
      allow list: if isPlatformFounder() || isStaffMember(resource.data.propertyId);

      allow create: if isPlatformFounder();

      allow update: if isPlatformFounder() || (
        isPropertyActive(resource.data.propertyId) && (
          // GM can update full room config
          isPropertyManager(resource.data.propertyId) ||
          // Staff can ONLY update check-in/out operational status & notes
          (
            isStaffMember(resource.data.propertyId) &&
            request.resource.data.propertyId == resource.data.propertyId &&
            request.resource.data.get('archived', false) == resource.data.get('archived', false) &&
            request.resource.data.get('name', '') == resource.data.get('name', '') &&
            request.resource.data.get('wifiName', '') == resource.data.get('wifiName', '') &&
            request.resource.data.get('wifiPassword', '') == resource.data.get('wifiPassword', '')
          )
        )
      );

      allow delete: if isPlatformFounder();
    }

    // Stays:
    // - No public read. Only platform founder or staff member of that property can get or list.
    // - Create / Update: staff member / manager / founder when property active.
    // - Delete: Founder only.
    match /stays/{stayId} {
      allow get: if isPlatformFounder() || isStaffMember(resource.data.propertyId);
      allow list: if isPlatformFounder() || isStaffMember(resource.data.propertyId);

      allow create: if isPlatformFounder() || (
        isStaffMember(request.resource.data.propertyId) &&
        isPropertyActive(request.resource.data.propertyId)
      );

      allow update: if isPlatformFounder() || (
        isStaffMember(resource.data.propertyId) &&
        isPropertyActive(resource.data.propertyId) &&
        request.resource.data.propertyId == resource.data.propertyId
      );

      allow delete: if isPlatformFounder();
    }

    // QR Codes:
    // - Guest public read: get active token doc containing guest-facing data.
    // - List: only platform founder or staff of that property.
    // - Create, update, delete: founder or property manager.
    match /qrCodes/{token} {
      allow get: if resource.data.status == 'active' ||
                    isPlatformFounder() ||
                    isStaffMember(resource.data.propertyId);

      allow list: if isPlatformFounder() ||
                     isStaffMember(resource.data.propertyId);

      allow create, update: if isPlatformFounder() || (
        isPropertyManager(request.resource.data.propertyId) &&
        isPropertyActive(request.resource.data.propertyId)
      );

      allow delete: if isPlatformFounder() || (
        isPropertyManager(resource.data.propertyId) &&
        isPropertyActive(resource.data.propertyId)
      );
    }

    // Guest Sessions:
    // - Anonymous guest session bound to active QR token, roomId, and activeStayId.
    // - Create: authenticated user creates own doc matching active QR token data.
    // - Get: owner, founder, or staff member of that property.
    // - List: staff or founder only.
    // - Update, delete: owner or founder.
    match /guestSessions/{uid} {
      allow create: if isAuthenticated() &&
        request.auth.uid == uid &&
        request.resource.data.token is string &&
        exists(/databases/$(database)/documents/qrCodes/$(request.resource.data.token)) &&
        get(/databases/$(database)/documents/qrCodes/$(request.resource.data.token)).data.status == 'active' &&
        get(/databases/$(database)/documents/qrCodes/$(request.resource.data.token)).data.roomId == request.resource.data.roomId &&
        get(/databases/$(database)/documents/qrCodes/$(request.resource.data.token)).data.activeStayId == request.resource.data.stayId;

      allow get: if (isAuthenticated() && request.auth.uid == uid) ||
                    isPlatformFounder() ||
                    ('propertyId' in resource.data && isStaffMember(resource.data.propertyId));

      allow list: if isPlatformFounder() ||
                     (isUserActive() && getUserData().role in ['staff', 'manager', 'admin']);

      allow update, delete: if (isAuthenticated() && request.auth.uid == uid) || isPlatformFounder();
    }

    // Requests:
    // - Guest create: authenticated, active guest session, matching roomId/stayId/guestUid, status 'pending', archived false, active property.
    // - Staff create: staff member can create requests when property active.
    // - Guest read: authenticated matching guestUid or active session stayId.
    // - Staff/GM/Founder read: isPlatformFounder() or isStaffMember(propertyId).
    // - Guest list query: bounded to limit <= 50 and filters by guestUid == auth.uid or matches active stay.
    // - Guest update: cancel pending, or deliveryPreference while not completed; cannot touch archived/verification/assignedTo/title.
    // - Staff/GM update:
    //     * Property active & propertyId unchanged & legacy roomId resilient.
    //     * GM/Founder: can verify (verification: 'verified'), reopen, update. Archive allowed ONLY if cancelled or (completed and verified).
    //     * Staff: can set status: 'completed' and verification: 'pending'. CANNOT set verification: 'verified'. CANNOT archive.
    // - Delete: Founder or GM.
    match /requests/{requestId} {
      allow get: if isPlatformFounder() ||
                    isStaffMember(resource.data.propertyId) ||
                    (
                      isAuthenticated() && (
                        resource.data.get('guestUid', '') == request.auth.uid ||
                        (
                          exists(/databases/$(database)/documents/guestSessions/$(request.auth.uid)) &&
                          get(/databases/$(database)/documents/guestSessions/$(request.auth.uid)).data.stayId == resource.data.stayId
                        )
                      )
                    );

      allow list: if isPlatformFounder() ||
                     isStaffMember(resource.data.propertyId) ||
                     (
                       isAuthenticated() &&
                       request.query.limit != null &&
                       request.query.limit <= 50 &&
                       (
                         resource.data.get('guestUid', '') == request.auth.uid ||
                         (
                           exists(/databases/$(database)/documents/guestSessions/$(request.auth.uid)) &&
                           get(/databases/$(database)/documents/guestSessions/$(request.auth.uid)).data.stayId == resource.data.stayId
                         )
                       )
                     );

      allow create: if isPlatformFounder() || (
        isPropertyActive(request.resource.data.propertyId) && (
          // Staff member create
          isStaffMember(request.resource.data.propertyId) ||
          // Guest create with active session
          (
            isAuthenticated() &&
            hasActiveGuestSession(request.auth.uid, request.resource.data.roomId, request.resource.data.stayId) &&
            request.resource.data.guestUid == request.auth.uid &&
            request.resource.data.status == 'pending' &&
            request.resource.data.get('archived', false) == false
          )
        )
      );

      allow update: if isPlatformFounder() || (
        isPropertyActive(resource.data.propertyId) &&
        request.resource.data.propertyId == resource.data.propertyId &&
        (!('roomId' in resource.data) || request.resource.data.roomId == resource.data.roomId) &&
        (
          // GM / Property Manager update
          (
            isPropertyManager(resource.data.propertyId) &&
            // Archiving rule: If setting archived: true, must be cancelled or (completed and verified)
            (
              request.resource.data.get('archived', false) != true ||
              resource.data.status == 'cancelled' ||
              (
                resource.data.status == 'completed' &&
                (resource.data.get('verification', '') == 'verified' || request.resource.data.get('verification', '') == 'verified')
              )
            )
          ) ||
          // Staff update (cannot archive tickets, cannot set verification to 'verified')
          (
            isStaffMember(resource.data.propertyId) &&
            request.resource.data.get('archived', false) == resource.data.get('archived', false) &&
            request.resource.data.get('verification', '') != 'verified' &&
            (
              request.resource.data.get('verification', '') == resource.data.get('verification', '') ||
              (request.resource.data.status == 'completed' && request.resource.data.get('verification', '') == 'pending')
            )
          ) ||
          // Guest update (cancel while pending, or change deliveryPreference while active)
          (
            isAuthenticated() &&
            resource.data.get('guestUid', '') == request.auth.uid &&
            request.resource.data.get('guestUid', '') == resource.data.get('guestUid', '') &&
            request.resource.data.get('archived', false) == false &&
            request.resource.data.get('verification', '') == resource.data.get('verification', '') &&
            request.resource.data.get('assignedTo', null) == resource.data.get('assignedTo', null) &&
            request.resource.data.title == resource.data.title &&
            (
              // Cancel while pending
              (
                resource.data.status == 'pending' &&
                request.resource.data.status == 'cancelled'
              ) ||
              // Update delivery preference while active
              (
                !(resource.data.status in ['completed', 'cancelled']) &&
                request.resource.data.status == resource.data.status
              )
            )
          )
        )
      );

      allow delete: if isPlatformFounder() || (
        isPropertyManager(resource.data.propertyId) &&
        isPropertyActive(resource.data.propertyId)
      );
    }

    // Media (House photos, property cover):
    // - Up to 400 KB, JPEG mimeType
    // - Publicly readable
    // - Writes by GM or Founder
    match /media/{mediaId} {
      allow read: if true;

      allow create, update: if (
        isPlatformFounder() || (
          isPropertyManager(request.resource.data.propertyId) &&
          isPropertyActive(request.resource.data.propertyId)
        )
      ) &&
      request.resource.data.mimeType == 'image/jpeg' &&
      request.resource.data.dataUrl is string &&
      request.resource.data.dataUrl.size() <= 409600;

      allow delete: if isPlatformFounder() || (
        isPropertyManager(resource.data.propertyId) &&
        isPropertyActive(resource.data.propertyId)
      );
    }

    // Users:
    // - Unauthenticated CANNOT read or list users.
    // - Deactivated user CANNOT read or write users.
    // - Staff/Manager can read own profile & colleagues in same property.
    // - ONLY Founder can create users.
    // - ONLY Founder can change roles or property assignment or deactivation.
    // - Staff/Manager can update non-privileged fields on own profile.
    match /users/{userId} {
      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        isPlatformFounder() ||
        (isUserActive() && getUserData().propertyId == resource.data.propertyId)
      );

      allow list: if isPlatformFounder() || (
        isUserActive() && getUserData().role in ['manager', 'admin']
      );

      allow create: if isPlatformFounder();

      allow update: if isPlatformFounder() || (
        isUserActive() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.propertyId == resource.data.propertyId &&
        request.resource.data.active == resource.data.active &&
        request.resource.data.email == resource.data.email
      );

      allow delete: if isPlatformFounder();

      match /devices/{deviceToken} {
        allow read, write: if isPlatformFounder() || (isUserActive() && request.auth.uid == userId);
      }
    }

    // Staff Devices:
    // - Registered FCM tokens per staff user
    match /staffDevices/{deviceId} {
      allow read, write: if isPlatformFounder() || (isUserActive() && request.auth.uid == resource.data.userId);
      allow create: if isPlatformFounder() || (isUserActive() && request.auth.uid == request.resource.data.userId);
    }

    // Activity Log:
    // - Manager & Founder can read (or active staff for authenticated listeners)
    // - Staff/Manager/Founder (isUserActive()) can record activity
    // - Guests and unauthenticated CANNOT create activity directly
    match /activity/{activityId} {
      allow read: if isPlatformFounder() || (
        isUserActive() && getUserData().role in ['staff', 'manager', 'founder', 'admin']
      );

      allow create: if isPlatformFounder() || isUserActive();

      allow update, delete: if isPlatformFounder();
    }

    // Dining (Out of pilot scope, but kept safe):
    match /dining/{diningId} {
      allow read: if true;
      allow write: if isPlatformFounder() || (
        isPropertyManager(request.resource.data.propertyId) &&
        isPropertyActive(request.resource.data.propertyId)
      );
    }

    // Leads (Landing page quote requests):
    // - Unauthenticated / anyone can CREATE a lead with strictly validated fields:
    //   name, propertyName, propertyType, city, whatsapp (<= 120 chars)
    //   optional email (<= 120), optional message (<= 1000), rooms int 1-2000
    //   source == 'landing'
    // - NO ONE except platform Founder can read, update, or delete leads.
    match /leads/{leadId} {
      allow get, list, update, delete: if isPlatformFounder();
      allow create: if request.resource.data.keys().hasOnly([
          'id', 'name', 'propertyName', 'propertyType', 'rooms', 'city', 'whatsapp', 'email', 'message', 'source', 'status', 'notes', 'createdAt'
        ]) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
        request.resource.data.propertyName is string && request.resource.data.propertyName.size() > 0 && request.resource.data.propertyName.size() <= 120 &&
        request.resource.data.propertyType is string && request.resource.data.propertyType.size() <= 120 &&
        request.resource.data.city is string && request.resource.data.city.size() <= 120 &&
        request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 120 &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120)) &&
        (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 1000)) &&
        request.resource.data.rooms is int && request.resource.data.rooms >= 1 && request.resource.data.rooms <= 2000 &&
        request.resource.data.source == 'landing';
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
