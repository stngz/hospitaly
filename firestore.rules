rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions & Security Invariants
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function hasUserProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      return isAuthenticated() &&
        hasUserProfile() &&
        getUserData().active == true;
    }

    function isKnownFounderEmail() {
      return isAuthenticated() &&
        request.auth.token.email in ['nathanielmazaba@gmail.com', 'founder.pilot@hospitaly.app'];
    }

    function isPlatformFounder() {
      return isAuthenticated() && (
        isKnownFounderEmail() ||
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role in ['founder', 'admin']) ||
        (isUserActive() && getUserData().role in ['founder', 'admin'])
      );
    }

    function isPropertyManager(propId) {
      return isPlatformFounder() || (
        isUserActive() &&
        getUserData().role in ['manager', 'admin'] &&
        getUserData().propertyId == propId
      );
    }

    function isStaffMember(propId) {
      return isPlatformFounder() || (
        isUserActive() &&
        getUserData().role in ['staff', 'manager', 'admin'] &&
        getUserData().propertyId == propId
      );
    }

    function isPropertyActive(propId) {
      return exists(/databases/$(database)/documents/properties/$(propId)) &&
        get(/databases/$(database)/documents/properties/$(propId)).data.status == 'active';
    }

    function isPublicRoom() {
      return (!('currentGuestName' in resource.data) || resource.data.currentGuestName == null || resource.data.currentGuestName == '') &&
             (!('guestPhone' in resource.data) || resource.data.guestPhone == null || resource.data.guestPhone == '');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Properties:
    // - Active properties readable by anyone; suspended readable by platform founder or assigned staff
    // - Updates allowed by Founder, or by Manager of that property (cannot change property status)
    match /properties/{propertyId} {
      allow get: if resource.data.status == 'active' || isPlatformFounder() || isStaffMember(propertyId);
      allow list: if isPlatformFounder() || (isUserActive() && getUserData().role in ['staff', 'manager', 'admin']);

      allow create: if isPlatformFounder();

      allow update: if isPlatformFounder() || (
        isPropertyManager(propertyId) &&
        isPropertyActive(propertyId) &&
        request.resource.data.status == resource.data.status
      );

      allow delete: if isPlatformFounder();
    }

    // Rooms (Houses):
    // - Unauthenticated CANNOT list rooms (test plan §A.1).
    // - Anyone can get a specific non-PII room (or staff can get occupied room).
    // - Staff of property can list rooms when active.
    // - Staff can update operational check-in/out fields only.
    // - Manager can edit room configuration (Wi-Fi, rules, photo).
    // - When property suspended, non-founder writes are blocked.
    match /rooms/{roomId} {
      allow get: if isPlatformFounder() ||
                    isStaffMember(resource.data.propertyId) ||
                    isPublicRoom() ||
                    (
                      // Guest in an active stay can read their room
                      'activeStayId' in resource.data &&
                      resource.data.activeStayId != null
                    );

      allow list: if isPlatformFounder() ||
                     (isUserActive() && getUserData().role in ['staff', 'manager', 'admin']);

      allow create: if isPlatformFounder() || (
        isPropertyManager(request.resource.data.propertyId) &&
        isPropertyActive(request.resource.data.propertyId)
      );

      allow update: if isPlatformFounder() || (
        isPropertyActive(resource.data.propertyId) && (
          // GM can update full room config
          isPropertyManager(resource.data.propertyId) ||
          // Staff can ONLY update check-in/out operational status & notes
          (
            isStaffMember(resource.data.propertyId) &&
            request.resource.data.propertyId == resource.data.propertyId &&
            request.resource.data.get('archived', false) == resource.data.get('archived', false) &&
            request.resource.data.get('name', '') == resource.data.get('name', '') &&
            request.resource.data.get('wifiName', '') == resource.data.get('wifiName', '') &&
            request.resource.data.get('wifiPassword', '') == resource.data.get('wifiPassword', '')
          )
        )
      );

      allow delete: if isPlatformFounder() || (
        isPropertyManager(resource.data.propertyId) &&
        isPropertyActive(resource.data.propertyId)
      );
    }

    // Stays:
    // - Unauthenticated CANNOT list stays.
    // - Anyone can get a specific stay by ID.
    // - Staff of property can create/update stays while property is active.
    // - When property suspended, non-founder writes are blocked.
    match /stays/{stayId} {
      allow get: if true;

      allow list: if isPlatformFounder() ||
                     (isUserActive() && getUserData().role in ['staff', 'manager', 'admin']);

      allow create: if isPlatformFounder() || (
        isStaffMember(request.resource.data.propertyId) &&
        isPropertyActive(request.resource.data.propertyId)
      );

      allow update: if isPlatformFounder() || (
        isStaffMember(resource.data.propertyId) &&
        isPropertyActive(resource.data.propertyId) &&
        request.resource.data.propertyId == resource.data.propertyId
      );

      allow delete: if isPlatformFounder();
    }

    // QR Codes:
    // - Anyone can get or read active QR code.
    // - Staff/Manager/Founder manage QR codes.
    match /qrCodes/{qrId} {
      allow read: if resource.data.status == 'active' ||
                     isPlatformFounder() ||
                     isStaffMember(resource.data.propertyId);

      allow create, update: if isPlatformFounder() || (
        isPropertyManager(request.resource.data.propertyId) &&
        isPropertyActive(request.resource.data.propertyId)
      );

      allow delete: if isPlatformFounder() || (
        isPropertyManager(resource.data.propertyId) &&
        isPropertyActive(resource.data.propertyId)
      );
    }

    // Requests:
    // - Unauthenticated CANNOT list requests.
    // - Guest can create request only for room/stay of their token and only while property is active.
    // - Guest can read only requests with their stayId; cannot read another stay's requests.
    // - Staff of property A cannot read or write property B.
    // - Staff cannot archive tickets.
    // - Manager can archive cancelled/completed tickets.
    // - Guest can cancel pending or update deliveryPreference while not completed.
    // - When property suspended, non-founder writes are blocked.
    match /requests/{requestId} {
      allow get: if isPlatformFounder() ||
                    isStaffMember(resource.data.propertyId) ||
                    (
                      // Guest can read request if it matches active stay of the room
                      isPropertyActive(resource.data.propertyId) &&
                      exists(/databases/$(database)/documents/rooms/$(resource.data.roomId)) &&
                      get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.activeStayId == resource.data.stayId &&
                      (!('guestUid' in resource.data) || (isAuthenticated() && resource.data.guestUid == request.auth.uid))
                    );

      allow list: if isPlatformFounder() ||
                     (isUserActive() && isStaffMember(resource.data.propertyId)) ||
                     (
                       // Guest query bounded to their active stay
                       request.query.limit != null &&
                       request.query.limit <= 50 &&
                       isPropertyActive(resource.data.propertyId) &&
                       exists(/databases/$(database)/documents/rooms/$(resource.data.roomId)) &&
                       get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.activeStayId == resource.data.stayId &&
                       (!('guestUid' in resource.data) || (isAuthenticated() && resource.data.guestUid == request.auth.uid))
                     );

      allow create: if isPlatformFounder() || (
        isPropertyActive(request.resource.data.propertyId) && (
          // Staff member create
          isStaffMember(request.resource.data.propertyId) ||
          // Guest create: property active, room exists & occupied & not archived, stayId matches room.activeStayId
          (
            request.resource.data.status == 'pending' &&
            request.resource.data.get('archived', false) == false &&
            exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)) &&
            get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.status == 'occupied' &&
            get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.propertyId == request.resource.data.propertyId &&
            get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.get('archived', false) == false &&
            request.resource.data.stayId == get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.activeStayId
          )
        )
      );

      allow update: if isPlatformFounder() || (
        isPropertyActive(resource.data.propertyId) &&
        request.resource.data.propertyId == resource.data.propertyId &&
        request.resource.data.roomId == resource.data.roomId &&
        (
          // Property Manager update
          (
            isPropertyManager(resource.data.propertyId) &&
            // If setting archived: true, request must be cancelled or completed
            (
              request.resource.data.get('archived', false) != true ||
              resource.data.status in ['cancelled', 'completed']
            )
          ) ||
          // Staff update (cannot archive tickets)
          (
            isStaffMember(resource.data.propertyId) &&
            request.resource.data.get('archived', false) == resource.data.get('archived', false)
          ) ||
          // Guest update (cancel while pending, or change deliveryPreference)
          (
            // Guest cancel while pending
            (
              resource.data.status == 'pending' &&
              request.resource.data.status == 'cancelled' &&
              request.resource.data.title == resource.data.title &&
              request.resource.data.get('archived', false) == false &&
              request.resource.data.get('assignedTo', null) == resource.data.get('assignedTo', null)
            ) ||
            // Guest update deliveryPreference while active
            (
              !(resource.data.status in ['completed', 'cancelled']) &&
              request.resource.data.status == resource.data.status &&
              request.resource.data.get('archived', false) == false &&
              request.resource.data.get('assignedTo', null) == resource.data.get('assignedTo', null) &&
              request.resource.data.title == resource.data.title
            )
          )
        )
      );

      allow delete: if isPlatformFounder() || (
        isPropertyManager(resource.data.propertyId) &&
        isPropertyActive(resource.data.propertyId)
      );
    }

    // Media (House photos, property cover):
    // - Up to 400 KB, JPEG mimeType
    // - Publicly readable
    // - Writes by GM or Founder
    match /media/{mediaId} {
      allow read: if true;

      allow create, update: if (
        isPlatformFounder() || (
          isPropertyManager(request.resource.data.propertyId) &&
          isPropertyActive(request.resource.data.propertyId)
        )
      ) &&
      request.resource.data.mimeType == 'image/jpeg' &&
      request.resource.data.dataUrl is string &&
      request.resource.data.dataUrl.size() <= 409600;

      allow delete: if isPlatformFounder() || (
        isPropertyManager(resource.data.propertyId) &&
        isPropertyActive(resource.data.propertyId)
      );
    }

    // Users:
    // - Unauthenticated CANNOT read or list users.
    // - Deactivated user CANNOT read or write users.
    // - Staff/Manager can read own profile & colleagues in same property.
    // - ONLY Founder can create users.
    // - ONLY Founder can change roles or property assignment or deactivation.
    // - Staff/Manager can update non-privileged fields on own profile.
    match /users/{userId} {
      allow get: if isPlatformFounder() || (
        isUserActive() && (
          request.auth.uid == userId ||
          getUserData().propertyId == resource.data.propertyId
        )
      );

      allow list: if isPlatformFounder() || (
        isUserActive() && getUserData().role in ['manager', 'admin']
      );

      allow create: if isPlatformFounder();

      allow update: if isPlatformFounder() || (
        isUserActive() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.propertyId == resource.data.propertyId &&
        request.resource.data.active == resource.data.active &&
        request.resource.data.email == resource.data.email
      );

      allow delete: if isPlatformFounder();

      match /devices/{deviceToken} {
        allow read, write: if isPlatformFounder() || (isUserActive() && request.auth.uid == userId);
      }
    }

    // Activity Log:
    // - Manager & Founder can read
    // - Staff/Manager/Founder or active property can record activity
    match /activity/{activityId} {
      allow read: if isPlatformFounder() || (
        isUserActive() && getUserData().role in ['manager', 'founder', 'admin']
      );

      allow create: if isPlatformFounder() || isUserActive() || isPropertyActive(request.resource.data.propertyId);

      allow update, delete: if isPlatformFounder();
    }

    // Dining (Out of pilot scope, but kept safe):
    match /dining/{diningId} {
      allow read: if true;
      allow write: if isPlatformFounder() || (
        isPropertyManager(request.resource.data.propertyId) &&
        isPropertyActive(request.resource.data.propertyId)
      );
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
