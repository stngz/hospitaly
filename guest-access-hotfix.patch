+await env.withSecurityRulesDisabled(async (ctx) => {
+  const db = ctx.firestore();
+  await setDoc(doc(db,'properties/p1'),{id:'p1',status:'active',name:'Rock'});
+  await setDoc(doc(db,'rooms/room1'),{id:'room1',propertyId:'p1',status:'occupied',activeStayId:'stay1',name:'Chisenga'});
+  await setDoc(doc(db,'rooms/room2'),{id:'room2',propertyId:'p1',status:'occupied',activeStayId:'stay9',name:'Bobo'});
+  await setDoc(doc(db,'stays/stay1'),{id:'stay1',roomId:'room1',propertyId:'p1',status:'active'});
+  await setDoc(doc(db,'stays/stay9'),{id:'stay9',roomId:'room2',propertyId:'p1',status:'active'});
+  await setDoc(doc(db,'qrCodes/TOKEN1'),{id:'TOKEN1',token:'TOKEN1',roomId:'room1',propertyId:'p1',status:'active'});
+  await setDoc(doc(db,'qrCodes/TOKEN2'),{id:'TOKEN2',token:'TOKEN2',roomId:'room2',propertyId:'p1',status:'active'});
+});
+const results=[]; const t=async(name,p)=>{try{await p;results.push('PASS '+name)}catch(e){results.push('FAIL '+name+' :: '+e.message.split('\n')[0])}};
